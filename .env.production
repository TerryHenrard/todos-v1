# Production environment variables
# This file is loaded when NODE_ENV=production

BETTER_AUTH_SECRET='your-production-secret-here'
BETTER_AUTH_URL='https://your-production-domain.com'

# Use your production database URL
DATABASE_URL='your-production-database-url-here'

# Production GitHub OAuth app credentials
GITHUB_CLIENT_ID='your-production-github-client-id'
GITHUB_CLIENT_SECRET='your-production-github-client-secret'
